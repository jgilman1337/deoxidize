#!/usr/bin/env python3
"""Ergonomic entry point: execs deoxidize.py so the tool stays `./deoxidize`.

The engine lives in deoxidize.py (a .py filename keeps ruff/pyright happy);
this shim just forwards to it.
"""

import os
import runpy

script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "deoxidize.py")
runpy.run_path(script, run_name="__main__")
